---
import type { ThemeInfo } from "../lib/themes";
import { previewColors } from "../lib/preview";

interface Props {
  theme: ThemeInfo;
}
const { theme } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const c = previewColors(theme);
// Bar widths in percent, so each card reads as a few lines of code.
const bars = [
  { color: c.keyword, width: 38 },
  { color: c.string, width: 62 },
  { color: c.function, width: 48 },
  { color: c.type, width: 30 },
  { color: c.comment, width: 70 },
];
---

<div class="card h-100">
  <div class="theme-preview" style={`background:${c.background}`} aria-hidden="true">
    {bars.map((b) => <span style={`background:${b.color};width:${b.width}%`} />)}
  </div>
  <div class="card-body">
    <h2 class="h5 card-title">
      <a class="stretched-link text-decoration-none" href={`${base}themes/#${theme.name}`}>{theme.label}</a>
    </h2>
    <p class="card-text">{theme.tagline}</p>
  </div>
</div>

<style>
  .theme-preview {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem;
    border-top-left-radius: inherit;
    border-top-right-radius: inherit;
  }
  .theme-preview span {
    display: block;
    height: 0.45rem;
    border-radius: 0.25rem;
  }
</style>

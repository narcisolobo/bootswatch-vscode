---
import { SITE } from "../../site.config.mjs";
import { loadThemes } from "../lib/themes";
import { themeCss } from "../lib/themeCss";
import { bootswatchHref, initialTheme, safeStore } from "../lib/switcher";

interface Props {
  title: string;
  active: "home" | "themes" | "docs" | "releases";
}
const { title, active } = Astro.props;

const themes = loadThemes();
const names = themes.map((t) => t.name);
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const github = `https://github.com/${SITE.owner}/${SITE.repo}`;

// Runs before first paint so the page never flashes the wrong theme. It reuses the
// tested functions' own source, so the logic exists in one place.
const bootScript = `(function(){
var bootswatchHref=${bootswatchHref.toString()};
var initialTheme=${initialTheme.toString()};
var safeStore=${safeStore.toString()};
var storage;try{storage=window.localStorage}catch(e){}
var t=initialTheme(${JSON.stringify(names)},location.hash,safeStore(storage).get(),${JSON.stringify(SITE.defaultTheme)});
document.documentElement.setAttribute("data-theme",t);
document.getElementById("bootswatch").setAttribute("href",bootswatchHref(t));
})();`;

const nav = [
  { key: "home", label: "Home", href: base },
  { key: "themes", label: "Themes", href: `${base}themes/` },
  { key: "docs", label: "Docs", href: `${base}docs/` },
  { key: "releases", label: "Release notes", href: `${base}releases/` },
];
---

<!doctype html>
<html lang="en" data-theme={SITE.defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link id="bootswatch" rel="stylesheet" href={bootswatchHref(SITE.defaultTheme)} />
    <script is:inline set:html={bootScript} />
    <style is:global set:html={themeCss(themes)} />
    <style is:global>
      body { overflow-x: hidden; }
    </style>
  </head>
  <body data-page={active} data-base={base}>
    <nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
      <div class="container">
        <a class="navbar-brand" href={base}>Bootswatch for VS Code</a>
        <button
          class="navbar-toggler"
          type="button"
          id="nav-toggle"
          aria-controls="nav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
          <ul class="navbar-nav me-auto">
            {
              nav.map((n) => (
                <li class="nav-item">
                  <a
                    class:list={["nav-link", { active: n.key === active }]}
                    href={n.href}
                    aria-current={n.key === active ? "page" : undefined}
                  >
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <label class="visually-hidden" for="theme-select">Theme</label>
          <select id="theme-select" class="form-select form-select-sm w-auto">
            {themes.map((t) => <option value={t.name}>{t.label}</option>)}
          </select>
        </div>
      </div>
    </nav>

    <main class="container py-4">
      <slot />
    </main>

    <footer class="container py-4 border-top small">
      <p class="mb-1">
        Themes based on <a href="https://bootswatch.com">Bootswatch</a> by Thomas Park, MIT License.
      </p>
      <p class="mb-0">
        <a href={github}>GitHub</a>
        {SITE.marketplaceUrl && <span> · <a href={SITE.marketplaceUrl}>VS Code Marketplace</a></span>}
      </p>
    </footer>

    <script>
      import { bootswatchHref, safeStore } from "../lib/switcher";

      let storage: Storage | undefined;
      try {
        storage = window.localStorage;
      } catch {
        storage = undefined;
      }
      const store = safeStore(storage);
      const select = document.getElementById("theme-select") as HTMLSelectElement;
      const link = document.getElementById("bootswatch") as HTMLLinkElement;
      const onThemesPage = document.body.dataset.page === "themes";

      function applyTheme(name: string, { fromHash = false } = {}) {
        document.documentElement.dataset.theme = name;
        link.href = bootswatchHref(name);
        select.value = name;
        store.set(name);
        if (onThemesPage && !fromHash) history.replaceState(null, "", `#${name}`);
        document.dispatchEvent(new CustomEvent("themechange", { detail: name }));
      }

      select.value = document.documentElement.dataset.theme ?? "";
      select.addEventListener("change", () => applyTheme(select.value));
      document.addEventListener("setTheme", (e) => applyTheme((e as CustomEvent<string>).detail));
      if (onThemesPage) {
        history.replaceState(null, "", `#${select.value}`);
        window.addEventListener("hashchange", () => {
          const wanted = location.hash.slice(1).toLowerCase();
          if (wanted !== document.documentElement.dataset.theme && [...select.options].some((o) => o.value === wanted)) {
            applyTheme(wanted, { fromHash: true });
          }
        });
      }
      document.dispatchEvent(new CustomEvent("themechange", { detail: select.value }));

      const toggle = document.getElementById("nav-toggle")!;
      const navEl = document.getElementById("nav")!;
      toggle.addEventListener("click", () => {
        const open = navEl.classList.toggle("show");
        toggle.setAttribute("aria-expanded", String(open));
      });
    </script>
  </body>
</html>

---
import Base from "./Base.astro";

const { frontmatter } = Astro.props;
---

<Base title={`${frontmatter.title} · Bootswatch for VS Code`} active={frontmatter.active}>
  <article class="doc mx-auto" style="max-width: 46rem">
    <h1 class="display-5 mb-4">{frontmatter.title}</h1>
    <slot />
  </article>
</Base>

<style is:global>
  .doc h2 { margin-top: 2.5rem; scroll-margin-top: 1rem; }
</style>

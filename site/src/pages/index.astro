---
import Base from "../layouts/Base.astro";
import ThemeCard from "../components/ThemeCard.astro";
import { loadThemes } from "../lib/themes";

const themes = loadThemes();
---

<Base title="Bootswatch for VS Code" active="home">
  <section class="py-4 text-center">
    <h1 class="display-4">Bootswatch for VS Code</h1>
    <p class="lead">
      All {themes.length} Bootswatch themes, as VS Code color themes. Pick one and watch the page change with it.
    </p>
  </section>
  <section class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
    {
      themes.map((t) => (
        <div class="col">
          <ThemeCard theme={t} />
        </div>
      ))
    }
  </section>
</Base>
